rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Application: Manoj Kumar Acharya Campaign Website (Anoopshahar)
// Project ID: manoj-acharya-anoopshahar
//
// Collection: support_messages
// Document ID: Auto-generated Firestore document ID
// Purpose: Supporter wall where villagers and community members can post encouraging
//          messages with optional photos for Sarpanch candidate Manoj Kumar Acharya,
//          and like each other's messages.
//
// Fields:
//   - alias: string (required, 1-50 chars) - Supporter alias, village ward, or moniker
//   - name: string (required, 1-100 chars) - Full name of the supporter
//   - message: string (required, 2-1000 chars) - Message of support / endorsement
//   - createdAt: timestamp (required, recent/request.time) - Timestamp when posted
//   - likes: int (required, initial value 0 or 1 on create; atomic +/- 1 on update) - Like count
//   - ward: string (optional, max 50 chars, or null) - Ward number or neighborhood
//   - category: string (optional, max 50 chars, or null) - Supporter category (e.g. youth, senior, farmer)
//   - avatar: string (optional, max 20 chars, or null) - Avatar emoji, icon identifier, or preset
//   - photo: string (optional, max 350,000 chars for compressed base64 data URL, or null) - Supporter photo
//   - status: string (optional, max 20 chars, or null) - Moderation status (e.g. 'removed')
//   - adminPasskey: string (optional, max 20 chars, or null) - Admin removal authorization passkey
//
// Access Patterns:
//   - Read: Public (anyone can read messages individually or query the collection)
//   - Create: Public with strict schema, field length, and type validation
//   - Update: Public ONLY for incrementing (+1) or decrementing (-1) the `likes` field,
//             OR authorized admin removal (setting status: 'removed', adminPasskey: '9529').
//             All other fields (name, alias, message, photo, createdAt, etc.) are immutable.
//   - Delete: Allowed when document was marked for admin deletion (status == 'removed' && adminPasskey == '9529')
//
// Collection: support_comments
// Document ID: Auto-generated Firestore document ID
// Purpose: Store comments posted by users on support posts
//
// Fields:
//   - postId: string (required, 1-100 chars) - ID of the support message being commented on
//   - authorId: string (required, 1-60 chars) - Public voter ID (e.g. 'ANP-XXXX' or 'समर्थक ANP-XXXX')
//   - text: string (required, 1-1000 chars) - Comment message text
//   - createdAt: timestamp (required, recent/request.time) - Timestamp when comment was created
//   - name: string (optional, max 100 chars, or null) - Optional confidential real name of commenter if already registered
//   - ward: string (optional, max 50 chars, or null) - Optional ward of commenter if already registered
//   - status: string (optional, max 20 chars, or null) - Moderation status (e.g. 'removed')
//   - adminPasskey: string (optional, max 20 chars, or null) - Admin removal authorization passkey
//
// Access Patterns:
//   - Read: Public (anyone can read single comments or query the collection)
//   - Create: Public with strict field validation, size constraints, allowed fields check, recent timestamp check
//   - Update: Authorized admin removal (setting status: 'removed', adminPasskey: '9529'). All other updates denied.
//   - Delete: Allowed when document was marked for admin deletion (status == 'removed' && adminPasskey == '9529')
//
// All other collections: Denied (default-deny at root)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions - support_messages
    // ===============================================================

    // Check if the required fields exist in the incoming message document
    function hasRequiredFields(data) {
      return data.keys().hasAll(['alias', 'name', 'message', 'createdAt', 'likes']);
    }

    // Ensure only the explicitly allowed fields are present in the message document
    function hasOnlyAllowedFields(data) {
      return data.keys().hasOnly(['alias', 'name', 'message', 'createdAt', 'likes', 'ward', 'category', 'avatar', 'photo', 'status', 'adminPasskey']);
    }

    // ===============================================================
    // Helper Functions - support_comments
    // ===============================================================

    // Check if the required fields exist in the incoming comment document
    function hasRequiredCommentFields(data) {
      return data.keys().hasAll(['postId', 'authorId', 'text', 'createdAt']);
    }

    // Ensure only the explicitly allowed fields are present in the comment document
    function hasOnlyAllowedCommentFields(data) {
      return data.keys().hasOnly(['postId', 'authorId', 'text', 'createdAt', 'name', 'ward', 'status', 'adminPasskey']);
    }

    // ===============================================================
    // Helper Functions - Admin Removal & Deletion
    // ===============================================================

    // Validates admin removal update: only status and adminPasskey can be affected,
    // status must be 'removed', and adminPasskey must match '9529'
    function isValidAdminRemoval() {
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasOnly(['status', 'adminPasskey']) &&
             request.resource.data.status == 'removed' &&
             request.resource.data.adminPasskey == '9529';
    }

    // Validates document deletion: document must have been marked for admin deletion
    function isMarkedForAdminDeletion() {
      return resource.data.status == 'removed' &&
             resource.data.adminPasskey == '9529';
    }

    // ===============================================================
    // Domain Validator - support_messages
    // ===============================================================

    // Validates the message document structure, field types, and size constraints.
    // MUST be called on both create and update to prevent schema corruption.
    function isValidMessage(data) {
      return hasRequiredFields(data) &&
             hasOnlyAllowedFields(data) &&
             // alias: string, 1-50 chars
             data.alias is string &&
             data.alias.size() >= 1 &&
             data.alias.size() <= 50 &&
             // name: string, 1-100 chars
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 100 &&
             // message: string, 2-1000 chars
             data.message is string &&
             data.message.size() >= 2 &&
             data.message.size() <= 1000 &&
             // createdAt: valid timestamp, not in the future beyond 5 minutes
             data.createdAt is timestamp &&
             data.createdAt <= request.time + duration.value(5, 'm') &&
             // likes: non-negative integer
             data.likes is int &&
             data.likes >= 0 &&
             // optional ward: string max 50 chars if provided
             (!('ward' in data) || data.ward == null || (data.ward is string && data.ward.size() <= 50)) &&
             // optional category: string max 50 chars if provided
             (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 50)) &&
             // optional avatar: string max 20 chars if provided
             (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() <= 20)) &&
             // optional photo: string max 350,000 chars (compressed base64 data URL) or null
             (!('photo' in data) || data.photo == null || (data.photo is string && data.photo.size() <= 350000)) &&
             // optional status: string max 20 chars if provided or null
             (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 20)) &&
             // optional adminPasskey: string max 20 chars if provided or null
             (!('adminPasskey' in data) || data.adminPasskey == null || (data.adminPasskey is string && data.adminPasskey.size() <= 20));
    }

    // Specific validation on message document creation
    function isValidMessageCreate() {
      let data = request.resource.data;
      return isValidMessage(data) &&
             // Initial likes count must be exactly 0 or 1
             (data.likes == 0 || data.likes == 1) &&
             // createdAt must be recent (within the last 24 hours, not far future)
             data.createdAt >= request.time - duration.value(24, 'h');
    }

    // Specific validation on message document update (only likes count may be toggled)
    function isValidLikeUpdate() {
      let diff = request.resource.data.diff(resource.data);
      let oldLikes = resource.data.likes;
      let newLikes = request.resource.data.likes;

      // Only 'likes' field is permitted to be affected; all other fields are strictly immutable
      return diff.affectedKeys().hasOnly(['likes']) &&
             (
               newLikes == oldLikes + 1 ||
               (oldLikes > 0 && newLikes == oldLikes - 1)
             );
    }

    // ===============================================================
    // Domain Validator - support_comments
    // ===============================================================

    // Validates comment document structure, field types, and size constraints.
    function isValidComment(data) {
      return hasRequiredCommentFields(data) &&
             hasOnlyAllowedCommentFields(data) &&
             // postId: string, 1-100 chars
             data.postId is string &&
             data.postId.size() >= 1 &&
             data.postId.size() <= 100 &&
             // authorId: string, 1-60 chars
             data.authorId is string &&
             data.authorId.size() >= 1 &&
             data.authorId.size() <= 60 &&
             // text: string, 1-1000 chars
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 1000 &&
             // createdAt: valid timestamp, not in the future beyond 5 minutes
             data.createdAt is timestamp &&
             data.createdAt <= request.time + duration.value(5, 'm') &&
             // optional name: string max 100 chars if provided or null
             (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 100)) &&
             // optional ward: string max 50 chars if provided or null
             (!('ward' in data) || data.ward == null || (data.ward is string && data.ward.size() <= 50)) &&
             // optional status: string max 20 chars if provided or null
             (!('status' in data) || data.status == null || (data.status is string && data.status.size() <= 20)) &&
             // optional adminPasskey: string max 20 chars if provided or null
             (!('adminPasskey' in data) || data.adminPasskey == null || (data.adminPasskey is string && data.adminPasskey.size() <= 20));
    }

    // Specific validation on comment document creation
    function isValidCommentCreate() {
      let data = request.resource.data;
      return isValidComment(data) &&
             // createdAt must be recent (within the last 24 hours, not far future)
             data.createdAt >= request.time - duration.value(24, 'h');
    }

    // ===============================================================
    // Rules for support_messages
    // ===============================================================

    match /support_messages/{messageId} {
      // 1. Public Read: Anyone can read single messages or query the collection
      allow read: if true;

      // 2. Public Create: Validated supporter message submission
      allow create: if isValidMessageCreate();

      // 3. Update: Liking / unliking (+1 or -1) OR admin removal with passkey
      allow update: if isValidMessage(request.resource.data) && (isValidLikeUpdate() || isValidAdminRemoval());

      // 4. Delete: Allowed when document was marked for admin deletion
      allow delete: if isMarkedForAdminDeletion();
    }

    // ===============================================================
    // Rules for support_comments
    // ===============================================================

    match /support_comments/{commentId} {
      // 1. Public Read: Anyone can read single comments or query the collection
      allow read: if true;

      // 2. Public Create: Validated comment submission with strict field and size limits
      allow create: if isValidCommentCreate();

      // 3. Update: Allowed ONLY for admin removal with passkey
      allow update: if isValidComment(request.resource.data) && isValidAdminRemoval();

      // 4. Delete: Allowed when document was marked for admin deletion
      allow delete: if isMarkedForAdminDeletion();
    }

    // ===============================================================
    // Default Deny Root
    // ===============================================================
    // Deny all reads and writes to any unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
